NETWATCH_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/netwatch.db
DATABASE_ECHO=false
# Boot default only. Switch between Simulation and Live Sensor at runtime in Settings.
NETWATCH_DEMO_MODE=false
NETWATCH_SUBNET=192.168.1.0/24
# Optional Windows + Docker Desktop host sensor integration. Leave blank to use the
# normal in-container discovery adapter; set this only after starting the sensor.
AUTO_DETECT_NETWORK=false
NETWATCH_HOST_SENSOR_URL=
# Optional dedicated token. When blank, a separate token is derived from NETWATCH_SECRET_KEY.
NETWATCH_HOST_SENSOR_TOKEN=
HOST_SENSOR_TIMEOUT_SECONDS=180
SCAN_INTERVAL=60
SCAN_CONCURRENCY=32
OFFLINE_AFTER_MISSED_SCANS=3
MONITORING_ENABLED=true
SERVICE_SCAN_ENABLED=true
SERVICE_PORTS=22,53,80,443,445,3389
NEW_DEVICE_ALERTS=true
NEW_DEVICE_POLICY=allow_alert
DEVICE_OFFLINE_ALERTS=true
NEW_SERVICE_ALERTS=true
LATENCY_ALERTS=true
RETENTION_DAYS=30
NETWATCH_TIMEZONE=Europe/Lisbon
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before saving provider passwords. Never commit the generated value.
NETWATCH_SECRET_KEY=
# Bundled Technitium DNS Server. Generate a strong unique administrator password.
TECHNITIUM_SERVER_URL=http://technitium:5380
TECHNITIUM_USERNAME=admin
TECHNITIUM_PASSWORD=
# Use 53 for network-wide DNS. 5453 is useful only for local testing when port 53 is busy.
TECHNITIUM_DNS_PORT=5453
TECHNITIUM_WEB_PORT=5380
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Used only by server-rendered frontend pages inside Docker.
NETWATCH_INTERNAL_API_URL=http://backend:8000
