NETWATCH_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/netwatch.db
DATABASE_ECHO=false
NETWATCH_DEMO_MODE=false
NETWATCH_SUBNET=192.168.1.0/24
SCAN_INTERVAL=60
SCAN_CONCURRENCY=32
OFFLINE_AFTER_MISSED_SCANS=3
MONITORING_ENABLED=true
SERVICE_SCAN_ENABLED=true
SERVICE_PORTS=22,53,80,443,445,3389
NEW_DEVICE_ALERTS=true
DEVICE_OFFLINE_ALERTS=true
NEW_SERVICE_ALERTS=true
LATENCY_ALERTS=true
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
